<!doctype html>
<html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0b0b0b"><meta name="apple-mobile-web-app-capable" content="yes"><title>Odjezdník · Prague departure board</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#0b0b0b;color:#f5f5f5;font:16px "Segoe UI",Arial,sans-serif;color-scheme:dark}
main{width:100%;max-width:900px;margin:24px auto;padding:0 16px}
header,.station,.controls,.row,.columns{display:-webkit-flex;display:flex;align-items:center}
header{justify-content:space-between;margin-bottom:20px}
.brand{font-size:19px;font-weight:600;letter-spacing:-.5px;color:#a3a3a3}
button,select{font:inherit;color:inherit;cursor:pointer}
button{min-height:44px;border:1px solid #454545;border-radius:6px;background:transparent;padding:8px 13px}
header button{font-size:13px;color:#bcbcbc}
article{background:#111;border:1px solid #303030;border-radius:12px;overflow:hidden}
.top{padding:24px}
.station{justify-content:space-between;gap:16px;margin-bottom:24px}
h1{min-width:0;font-size:36px;line-height:1.1;font-weight:600;letter-spacing:-1.2px;margin:0;overflow-wrap:break-word}
.clock{flex-shrink:0;color:#a3a3a3;font:500 19px monospace}
.controls{align-items:flex-start;flex-wrap:wrap;gap:8px}
.controls select{max-width:100%;min-height:44px;border:1px solid #454545;border-radius:6px;background:#171717;padding:8px 10px;font-size:15px}
.line-filter{flex:1;min-width:160px}
.line-filter summary{min-height:44px;cursor:pointer;border:1px solid #454545;border-radius:6px;padding:11px 12px;font-size:15px;color:#d4d4d4}
.line-panel{padding-top:12px}
.line-actions{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
.line-actions button{font-size:13px;color:#d4d4d4}
.line-group{border:0;padding:8px 0;margin:0}
.line-group legend{font-size:12px;color:#999;padding:0}
.line-choice{display:inline-flex;align-items:center;min-height:44px;border:1px solid #454545;border-radius:6px;margin:4px 6px 0 0;padding:4px 10px;cursor:pointer}
.line-choice input{margin:0 7px 0 0;width:18px;height:18px;accent-color:#dedede}
.filter-note{font-size:12px;color:#999}
.body{padding:0 24px}
.row,.columns{gap:0}
.row>div:first-child,.columns>span:first-child{width:54px;margin-right:14px;flex-shrink:0}
.row>div:nth-child(2),.columns>span:nth-child(2){flex:1;min-width:0}
.time,.columns>span:last-child{min-width:76px;margin-left:12px;text-align:right}
.columns{font-size:10px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:#888;padding:0 0 12px}
.row{border-top:1px solid #303030;padding:17px 0;min-height:82px}
.badge{width:54px;padding:5px 2px;border:1px solid #555;border-radius:4px;background:#242424;color:#f5f5f5;font:600 18px monospace;text-align:center;overflow-wrap:anywhere}
.dest{font-size:24px;font-weight:500;line-height:1.15;overflow-wrap:break-word}
.sub{font-size:12px;color:#929292;margin-top:5px}
.eta{color:#fff;font:600 36px/1 monospace;letter-spacing:-1.5px}
.unit{font:400 12px Arial;letter-spacing:0;color:#aaa}
footer{padding:10px 24px 16px;text-align:right}
footer a{color:#888;font-size:11px;text-decoration:none}
footer a:hover{text-decoration:underline}
.empty{padding:24px 0;color:#aaa;line-height:1.5}
button:focus-visible,select:focus-visible,input:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid #ddd;outline-offset:3px}
.displaying .controls{display:none}
.displaying .station{margin-bottom:0}
body:fullscreen{overflow:auto}
@media(max-width:599px){
 main{margin:14px auto;padding:0 12px}
 .top{padding:20px 16px}.body{padding:0 16px}footer{padding:10px 16px 16px}
 h1{font-size:29px}.clock{font-size:16px}.station{gap:12px;margin-bottom:20px}
 .controls select{font-size:14px}
 .row>div:first-child,.columns>span:first-child{width:40px;margin-right:10px}
 .badge{width:40px;font-size:16px}.dest{font-size:19px}.eta{font-size:29px}
 .time,.columns>span:last-child{min-width:60px;margin-left:8px}.row{min-height:76px;padding:15px 0}
}
@media(min-width:600px) and (max-width:1100px){
 main{max-width:1024px;margin:14px auto}.row{min-height:9vh}.dest{font-size:27px}.eta{font-size:40px}.sub{font-size:15px}
}
@media(min-width:600px) and (orientation:landscape) and (max-height:780px){
 main{margin:8px auto}header{margin-bottom:10px}.top{padding-top:16px;padding-bottom:16px}
 .station{margin-bottom:16px}h1{font-size:32px}.row{min-height:60px;padding:8px 0}.dest{font-size:23px}.eta{font-size:30px}.sub{margin-top:3px}
}
</style>
<main>
<header><div class="brand">Odjezdník</div><button id="display">Display mode</button></header>
<article>
<div class="top">
<div class="station"><h1 id="heading">Hlavní nádraží</h1><time class="clock" id="clock"></time></div>
<div class="controls">
<select id="station" aria-label="Choose station"></select>
<select id="mode" aria-label="Transport type"></select>
<details id="line-filter" class="line-filter"><summary id="line-summary">All lines</summary>
<div class="line-panel"><div class="line-actions"><button id="show-all" type="button">Show all</button><button id="hide-all" type="button">Hide all</button></div><div id="line-options"></div></div>
</details>
</div>
</div>
<div class="body"><div class="columns"><span>Line</span><span>Direction</span><span>Leaves in</span></div><div id="rows"></div></div>
<footer><a href="https://pid.cz/en/opendata/">Timetable data ↗</a></footer>
</article>
</main>
<script>
var db=/*TIMETABLE*/null;
var types={0:"Tram",1:"Metro",2:"Train",3:"Bus",4:"Ferry",7:"Funicular",11:"Trolleybus"};
var live=null,updated=0,sequence=0,failed=false,scheduled=[],cacheDay="",wake=null;
var loading=false,timetableError=false,loadSequence=0,excluded={},catalog=db.catalog||{},stationLines=[];
var onPages=/\.github\.io$/.test(location.hostname);
function el(id){return document.getElementById(id)}
function preference(key,value){try{if(value===undefined)return localStorage.getItem(key);localStorage.setItem(key,value)}catch(e){}}
function pad(n){return n<10?"0"+n:String(n)}
// Prague changes offset at 01:00 UTC on the last Sunday of March and October.
function offsetAt(t){
 var year=new Date(t).getUTCFullYear();
 function change(month){var last=new Date(Date.UTC(year,month+1,0,1));return last.getTime()-last.getUTCDay()*86400000}
 return t>=change(2)&&t<change(9)?7200000:3600000;
}
function local(t){return new Date(t+offsetAt(t))}
function clock(t){var d=local(t);return pad(d.getUTCHours())+":"+pad(d.getUTCMinutes())}
function dateKey(d){return String(d.getUTCFullYear())+pad(d.getUTCMonth()+1)+pad(d.getUTCDate())}
function stationKey(name){
 var key=String(name||"").toLowerCase().replace(/[á]/g,"a").replace(/í/g,"i").replace(/ž/g,"z").replace(/ř/g,"r").replace(/^praha[\s,.-]+/,"").replace(/[\s.,-]/g,"");
 return /^(hln|hlnadrazi|hlavninadr)$/.test(key)?"hlavninadrazi":key;
}
function routeKey(type,line){return String(type)+":"+line}
function linesForStation(){
 var name=el("station").value,seen={},result=[];
 function add(type,line){var key=routeKey(type,line);if(!seen[key]){seen[key]=true;result.push([Number(type),String(line)])}}
 if(catalog[name])catalog[name].lines.forEach(function(r){add(r[0],r[1])});
 (db.stations[name]||[]).forEach(function(r){add(r[3],r[2])});
 (live||[]).forEach(function(r){add(r.type,r.line)});
 return result.sort(function(a,b){return a[0]-b[0]||a[1].localeCompare(b[1],undefined,{numeric:true})});
}
function modes(){
 var select=el("mode"),seen={},saved=preference("mode:"+el("station").value);
 select.options.length=0;select.add(new Option("All transport","all"));
 stationLines=linesForStation();
 stationLines.forEach(function(r){if(!seen[r[0]]){seen[r[0]]=true;select.add(new Option(types[r[0]]||"Other",r[0]))}});
 if(saved&&seen[saved])select.value=saved;
}
function lineFilters(){
 var box=el("line-options"),mode=el("mode").value,groups={},shown=0,total=0;
 box.textContent="";
 stationLines=linesForStation();
 stationLines.forEach(function(r){
  if(mode!=="all"&&r[0]!=mode)return;
  var key=routeKey(r[0],r[1]);total++;if(!excluded[key])shown++;
  if(!groups[r[0]]){var group=document.createElement("fieldset"),legend=document.createElement("legend");group.className="line-group";legend.textContent=types[r[0]]||"Transit";group.appendChild(legend);box.appendChild(group);groups[r[0]]=group}
  var label=document.createElement("label"),input=document.createElement("input");label.className="line-choice";input.id="route-"+key;input.type="checkbox";input.checked=!excluded[key];input.setAttribute("aria-label",(types[r[0]]||"Transit")+" "+r[1]);
  input.onchange=function(){if(input.checked)delete excluded[key];else excluded[key]=true;saveLines();lineFilters();el("route-"+key).focus();render()};
  label.appendChild(input);label.appendChild(document.createTextNode(r[1]));groups[r[0]].appendChild(label);
 });
 el("line-summary").textContent=shown===total?"All lines ("+total+")":shown+" of "+total+" lines shown";
 if(!total)box.appendChild(part("filter-note","No departing lines in this timetable."));
}
function saveLines(){preference("hidden-lines:"+el("station").value,JSON.stringify(excluded))}
function setAllLines(show){stationLines.forEach(function(r){if(el("mode").value!=="all"&&r[0]!=el("mode").value)return;var key=routeKey(r[0],r[1]);if(show)delete excluded[key];else excluded[key]=true});saveLines();lineFilters();render()}
function loadTimetable(){
 var station=el("station").value,seq=++loadSequence;loading=false;timetableError=false;
 if(db.stations[station])return;
 if(location.protocol==="file:"){timetableError=true;return}
 loading=true;var req=new XMLHttpRequest();req.open("GET","data/"+catalog[station].file,true);req.timeout=20000;
 function failure(){if(seq===loadSequence){loading=false;timetableError=true;render()}}
 req.onerror=req.ontimeout=failure;
 req.onload=function(){
  if(seq!==loadSequence)return;
  try{if(req.status!==200)throw Error();var data=JSON.parse(req.responseText);if(!Array.isArray(data.rows)||!data.services)throw Error();db.stations[station]=data.rows;Object.keys(data.services).forEach(function(k){db.services[k]=data.services[k]});loading=false;cacheDay="";render()}catch(e){failure()}
 };req.send();
}
function schedule(now){
 var d=local(now),key=dateKey(d);
 if(cacheDay===key)return;cacheDay=key;scheduled=[];
 [-1,0,1].forEach(function(offset){
 var noon=Date.UTC(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate()+offset,12);
 var serviceDay=dateKey(new Date(noon)),start=noon-offsetAt(noon)-43200000;
 (db.stations[el("station").value]||[]).forEach(function(r){
 if(db.services[r[1]]&&db.services[r[1]].indexOf(serviceDay)>=0)scheduled.push({at:start+r[0]*1000,line:r[2],type:r[3],dest:r[4]});
 });
 });
 scheduled.sort(function(a,b){return a.at-b.at});
}
function part(cls,text){var n=document.createElement("div");n.className=cls;n.textContent=text;return n}
// A reinforced service can have several PID vehicle records for one advertised departure.
function upcomingRows(source,now,target,mode,hidden){
 var byService=Object.create(null),rows=[];
 source.forEach(function(r){
  if(r.at<now||stationKey(r.dest)===target||(mode!=="all"&&r.type!=mode)||(hidden&&hidden[routeKey(r.type,r.line)]))return;
  var key=JSON.stringify([r.scheduledAt||r.at,r.type,r.line,stationKey(r.dest)]);
  var previous=byService[key];
  if(previous===undefined){
   byService[key]=rows.length;rows.push(r);
  }else{
   var kept=rows[previous];
   if((r.predicted&&!kept.predicted)||(!!r.predicted===!!kept.predicted&&r.at<kept.at))rows[previous]=r;
  }
 });
 return rows.sort(function(a,b){return a.at-b.at}).slice(0,5);
}
function render(){
 var now=Date.now(),station=el("station").value,mode=el("mode").value,target=stationKey(station);
 el("heading").textContent=station;el("clock").textContent=clock(now);schedule(now);
 var fresh=live!==null&&!failed&&now-updated<(onPages?900000:90000);
 var rows=upcomingRows(fresh?live:scheduled,now,target,mode,excluded);
 var list=el("rows");list.textContent="";
 rows.forEach(function(r){
 var row=part("row",""),direction=part("",""),time=part("time",""),eta=part("eta",Math.ceil((r.at-now)/60000));
 var unit=document.createElement("span");unit.className="unit";unit.textContent=" min";eta.appendChild(unit);
 direction.appendChild(part("dest",r.dest));direction.appendChild(part("sub",(types[r.type]||"Transit")+(r.predicted?" · Predicted":" · Scheduled")));
 time.appendChild(eta);time.appendChild(part("sub",clock(r.at)+(r.delay>0?" · +"+r.delay+"m":"")));
 row.appendChild(part("badge "+(r.type===1?"metro"+r.line:""),r.line));row.appendChild(direction);row.appendChild(time);list.appendChild(row);
 });
 if(!rows.length)list.appendChild(part("empty",loading&&!fresh?"Loading this stop’s timetable…":timetableError&&!fresh?(location.protocol==="file:"?"Open the hosted board or run python server.py to load this stop.":"Could not load this stop. Select it again to retry."):dateKey(local(now))>db.end&&!fresh?"Timetable expired. Refresh the PID feed.":"No upcoming departures for the selected lines. Try Show all or another transport type."));
}
function refresh(){
 var seq=++sequence,station=el("station").value;
 if(location.protocol==="file:")return;
 var url=onPages?"https://raw.githubusercontent.com/yptacek-tech/odjezdnik/live-data/departures.json?t="+Math.floor(Date.now()/60000):"/api/departures?station="+encodeURIComponent(station);
 var req=new XMLHttpRequest();req.open("GET",url,true);req.timeout=12000;
 function failure(){if(seq===sequence){failed=true;render()}}
 req.onerror=req.ontimeout=failure;
 req.onload=function(){
 if(seq!==sequence)return;
 try{
 if(req.status!==200)throw Error();
 var data=JSON.parse(req.responseText);if(onPages){data=data[station];if(!data){live=null;failed=false;render();return}}
 updated=onPages?data.observed:Date.now();if(Date.now()-updated>900000)throw Error();
 live=data.rows;failed=false;var selectedMode=el("mode").value;modes();if(selectedMode==="all"||stationLines.some(function(r){return r[0]==selectedMode}))el("mode").value=selectedMode;lineFilters();render();
 }catch(e){failure()}
 };
 req.send();
}
function change(){cacheDay="";live=null;failed=false;try{excluded=JSON.parse(preference("hidden-lines:"+el("station").value)||"{}");if(!excluded||typeof excluded!=="object"||Array.isArray(excluded))excluded={}}catch(e){excluded={}}modes();lineFilters();loadTimetable();render();refresh()}
var stationNames=Object.keys(db.catalog||db.stations).sort(function(a,b){return a.localeCompare(b,"cs")});
stationNames.forEach(function(s){el("station").add(new Option(s,s))});
el("station").value=stationNames.indexOf("Hlavní nádraží")>=0?"Hlavní nádraží":stationNames[0];
el("station").onchange=change;
el("mode").onchange=function(){preference("mode:"+el("station").value,el("mode").value);lineFilters();render()};
el("show-all").onclick=function(){setAllLines(true)};el("hide-all").onclick=function(){setAllLines(false)};
function setDisplay(active){document.body.className=active?"displaying":"";el("display").textContent=active?"Exit display":"Display mode";el("display").setAttribute("aria-pressed",String(active))}
el("display").onclick=function(){
 var active=document.body.className!=="displaying";setDisplay(active);
 if(active){window.scrollTo(0,0);if(document.documentElement.requestFullscreen)document.documentElement.requestFullscreen().catch(function(){});
 if(navigator.wakeLock)navigator.wakeLock.request("screen").then(function(lock){wake=lock},function(){});
 }else{if(document.fullscreenElement)document.exitFullscreen();if(wake){wake.release();wake=null}}
};
document.onfullscreenchange=function(){if(!document.fullscreenElement){setDisplay(false);if(wake){wake.release();wake=null}}};
change();setInterval(render,5000);setInterval(refresh,30000);document.onvisibilitychange=function(){if(!document.hidden){render();refresh()}};
</script></html>
